{
  "title": "Owlet Live Monitor",
  "poll_seconds": 10,
  "defaults": {
    "history_size": 30,
    "vocalize": true,
    "chart": false,
    "poll_interval_seconds": 10,
    "vocalize_master": false
  },
  "boxes": [
    {"property": "heart_rate", "label": "Heart Rate", "type": "bpm", "chart": true},
    {
      "property": "oxygen_saturation",
      "label": "Oxygen Saturation",
      "type": "percent",
      "chart": true,
      "alerts": [
        {"name": "yellow", "when": "below", "threshold": 94, "consecutive": 3},
        {"name": "red", "when": "below", "threshold": 94, "consecutive": 5, "flash": true}
      ]
    },
    {"property": "oxygen_10_av", "label": "Oxygen 10m Avg", "type": "percent"},
    {"property": "skin_temperature", "label": "Skin Temp", "type": "int"},
    {"property": "movement", "label": "Movement", "type": "int"},
    {"property": "battery_minutes", "label": "Battery Time", "type": "minutes_duration"},
    {"property": "battery_percentage", "label": "Battery", "type": "percent"},
    {"property": "monitoring_start_time", "label": "Monitoring Start", "type": "epoch_with_age"},
    {"property": "last_updated", "label": "Last Refreshed", "type": "refreshed_age_seconds"}
  ]
}
