{
  "title": "Owlet Live Monitor",
  "poll_seconds": 10,
  "defaults": {
    "history_size": 30,
    "chart_values_count": 30,
    "vocalize": false,
    "chart": false,
    "poll_interval_seconds": 11,
    "vocalize_master": false,
    "vocalization_engine": "macos_say",
    "vocalization_interval_seconds": 32,
    "reconnect_stale_seconds": 180
  },
  "boxes": [
    {
      "property": "heart_rate",
      "label": "Heart Rate",
      "type": "bpm",
      "chart": true,
      "vocalize": false,
      "vocalization_short": "HR",
      "vocalization_priority": 2,
      "alerts": [
        {
          "name": "yellow",
          "when": "above",
          "threshold": 180,
          "consecutive": 1
        },
        {
          "name": "red",
          "when": "above",
          "threshold": 192,
          "consecutive": 1,
          "flash": true
        }
      ],
      "vocalize_alert": true
    },
    {
      "property": "oxygen_saturation",
      "label": "Oxygen Saturation",
      "type": "percent",
      "vocalize": true,
      "vocalization_short": "Oxygen",
      "vocalization_priority": 1,
      "chart": true,
      "alerts": [
        {
          "name": "yellow",
          "when": "below",
          "threshold": 94,
          "consecutive": 3
        },
        {
          "name": "red",
          "when": "below",
          "threshold": 94,
          "consecutive": 5,
          "flash": true
        }
      ]
    },
    {
      "property": "oxygen_10_av",
      "label": "Oxygen 10m Avg",
      "type": "percent",
      "vocalize_alert": true
    },
    {
      "property": "skin_temperature",
      "label": "Skin Temp",
      "type": "int",
      "vocalize_alert": true
    },
    {
      "property": "movement",
      "label": "Movement",
      "type": "movement_with_avg",
      "vocalize": false,
      "chart": true,
      "vocalize_alert": true
    },
    {
      "property": "battery_minutes",
      "label": "Battery Time",
      "type": "minutes_duration",
      "vocalize_alert": true
    },
    {
      "property": "battery_percentage",
      "label": "Battery",
      "type": "percent",
      "vocalize_alert": true
    },
    {
      "property": "monitoring_start_time",
      "label": "Monitoring Start",
      "type": "epoch_with_age",
      "vocalize_alert": true
    },
    {
      "property": "last_updated",
      "label": "Last Refreshed",
      "type": "refreshed_age_seconds",
      "vocalize_alert": true
    }
  ]
}
